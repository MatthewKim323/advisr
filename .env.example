# Advisr — environment variables
# Copy this file to `web/.env.local` and fill in your keys.
# Never commit the filled-in version.

# ---------- Models ----------
# Claude is the brain for every agent (Dean + the 6 specialists).
# We don't need OpenAI (Whisper/GPT-4o-vision) or Voyage (embeddings)
# because Human Delta handles doc parsing (PDF/audio/image/CSV → text)
# and embedding/retrieval server-side.
ANTHROPIC_API_KEY=sk-ant-...

# ---------- Supabase ----------
# Create a project at supabase.com, enable pgvector.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
DATABASE_URL=postgresql://postgres:[pwd]@db.xxxx.supabase.co:5432/postgres

# ---------- Browser automation ----------
BROWSER_USE_API_KEY=                # cloud.browser-use.com — preferred
# BROWSER_USE_MODE=cloud            # cloud | local

# ---------- Human Delta (shared context library) ----------
# ONE key is correct. All 7 agents share the same knowledge base — that's
# the whole point of the "shared persistent knowledge graph" pitch. Inside
# that single library, agents scope what they see via the `category` field
# on uploads (e.g. "student-records", "college-pages", "scholarship-db")
# and by reading source paths (/source/website/, /uploads/, etc.).
#
# Get your key from the Human Delta dashboard (or your hackathon organizer).
# Format: starts with `hd_live_`. Server-side only — never expose to browser.
HUMANDELTA_API_KEY=hd_live_...
# Optional: override the API host (defaults to https://api.humandelta.ai)
# HUMANDELTA_BASE_URL=https://api.humandelta.ai

# ---------- Landing-page CTA target ----------
# URL the Vite landing page links "Walk into the office" to. Used in `site/`.
# In dev the Next app runs on :2847.
VITE_SUBMARINE_URL=http://localhost:2847/office

# ---------- Demo mode ----------
DEMO_MODE=false                     # when true, serves browser-use responses from cache
DEMO_STUDENT_ID=maria               # auto-loads fixtures/maria as the current user
DEMO_DATE=                          # optional: simulate "today" (e.g. 2025-11-15) so Pacer
                                    # shows live EA/ED deadlines during demo recording.
                                    # Leave blank for real clock.
