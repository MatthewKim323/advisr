{
  "name": "nami-web",
  "version": "0.0.1",
  "private": true,
  "description": "Nami main application — Dean + the Tsunami (6 specialists) + knowledge graph + pixel office.",
  "scripts": {
    "dev": "next dev -p 2847",
    "build": "next build",
    "start": "next start -p 2847",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
