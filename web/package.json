    "humandelta": "^0.1.1",
    "lenis": "^1.3.23",
    "motion": "^12.38.0",
    "next": "^15.0.0",
    "pg": "^8.13.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-force-graph-2d": "^1.27.1",
    "server-only": "^0.0.1",
    "zod": "^4.3.6",
    "zustand": "^5.0.2"
