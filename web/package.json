    "hd:seed:scout": "tsx scripts/seed-hd.mts scout",
    "hd:seed:all": "tsx scripts/seed-hd.mts all",
    "eval:archivist": "tsx scripts/eval-archivist.mts",
    "seed": "tsx scripts/seed-maria.mts",
    "seed:dry": "tsx scripts/seed-maria.mts -- --dry",
    "seed:reset": "tsx scripts/seed-maria.mts -- --reset",
    "bootstrap": "tsx scripts/bootstrap.mts",
